# Keeps the Pi on the newest commit CI has passed (the unit the timer runs);
# deploy/auto-update.sh says what it does and how it rolls back.
#
#   sudo cp deploy/meshradio-autoupdate.service deploy/meshradio-autoupdate.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now meshradio-autoupdate.timer
#   sudo systemctl start meshradio-autoupdate.service   # run one now
#   journalctl -u meshradio-autoupdate                  # what it did
#
# Adjust MESHRADIO_DIR, MESHRADIO_USER and the ExecStart path if your
# username or clone location differ. The health check finds the radio's
# port in /etc/meshradio/config.toml ([web] port; MESHRADIO_CONFIG names
# another file, MESHRADIO_HEALTH_URL overrides the whole URL). It runs as
# root because it restarts meshradio.service;
# git and pip run as MESHRADIO_USER. That means root runs a script from that
# user's clone, so only use it where that user is trusted with sudo anyway
# (the default Pi user is). To stop updates, disable the timer.

[Unit]
Description=Update MeshRadio to the latest CI-passed commit
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=MESHRADIO_DIR=/home/pi/meshradio
Environment=MESHRADIO_USER=pi
StateDirectory=meshradio-autoupdate
ExecStart=/home/pi/meshradio/deploy/auto-update.sh
